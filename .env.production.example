# =============================================================================
# Qlix — PRODUCTION environment variables
# =============================================================================
# Copy this file to:
#   backend/.env       (backend reads this directly)
#   frontend/.env      (Next.js reads this for NEXT_PUBLIC_* vars)
#
# The two files share some values — see notes per section.
# =============================================================================

# ─── BACKEND (/var/www/qlix/backend/.env) ────────────────────────────────────

NODE_ENV=production
PORT=4000

# Public URL of the API (this server, HTTPS). Used in SDK agent file download links.
PUBLIC_API_URL=https://qlix.exora.solutions

# ─── Database ────────────────────────────────────────────────────────────────
# Points to the EXTERNAL PostgreSQL server (other Docker host).
DATABASE_URL=postgresql://USER:PASSWORD@OTHER_SERVER_IP:5432/qlix?schema=public

# ─── JWT session ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ─── CORS / cookie ───────────────────────────────────────────────────────────
FRONTEND_URL=https://qlix.exora.solutions
SESSION_COOKIE_SECURE=true

# ─── WebAuthn / passkeys ─────────────────────────────────────────────────────
WEBAUTHN_RP_NAME=Qlix
WEBAUTHN_RP_ID=qlix.exora.solutions
WEBAUTHN_ORIGIN=https://qlix.exora.solutions

# ─── Platform identity (Ed25519) ─────────────────────────────────────────────
# Generate your own — do NOT reuse these example values in production.
QLIX_PLATFORM_DID=did:qlix:platform
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QLIX_PLATFORM_PRIVATE_KEY=CHANGE_ME_64_HEX_CHARS

# ─── Agent secrets encryption key ────────────────────────────────────────────
# 64 hex chars (32 bytes). Generate same as above.
AGENT_SECRETS_KEY=CHANGE_ME_64_HEX_CHARS

# ─── Remote Docker daemon (the other server that runs agent containers) ───────
# Expose Docker TCP on the other server with TLS (recommended) or plain (LAN only).
# TLS example:  DOCKER_HOST=tcp://OTHER_SERVER_IP:2376  +  DOCKER_TLS_VERIFY=1
# Plain example (LAN/VPN only): DOCKER_HOST=tcp://OTHER_SERVER_IP:2375
DOCKER_HOST=tcp://OTHER_SERVER_IP:2375
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/path/to/docker/certs

# Where the backend stores agent runner state files (must be writable).
# On remote Docker, this path only matters for the Dockerfile/agent.json stored locally.
QLIX_CLOUD_RUNNER_STATE_DIR=/var/www/qlix/backend/.qlix-runners

# Cloud runner image (must already exist on the remote Docker host).
QLIX_CLOUD_RUNNER_IMAGE=qlix-cloud-runner:latest

# ─── LLM proxy providers ─────────────────────────────────────────────────────
EXORA_LLM_API_KEY=CHANGE_ME
EXORA_LLM_BASE_URL=https://llm.exora.solutions/v1
EXORA_LLM_ENABLED=true
EXORA_LLM_DEFAULT_MODEL=exora-general
EXORA_ALLOWED_MODEL_PREFIXES=exora/
QLIX_DEFAULT_LLM_PROVIDER=exora

# OpenRouter remains selectable and supplies embeddings by default.
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_PROVIDER=openrouter
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Google OAuth (optional — for Gmail connector) ───────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://qlix.exora.solutions/api/v1/connectors/google/callback

# Zoho CRM connector
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=
# ZOHO_OAUTH_REDIRECT_URI=https://qlix.exora.solutions/api/v1/connectors/zoho/callback

# Slack OAuth (user token — agents act as the member who connected)
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=https://qlix.exora.solutions/api/v1/connectors/slack/callback
# SLACK_SIGNING_SECRET=   # Events API signature verification (optional inbound)

# Discord OAuth (user token — identify / email / guilds)
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=https://qlix.exora.solutions/api/v1/connectors/discord/callback

# GitHub connector OAuth (separate from AUTH_GITHUB_* login)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=https://qlix.exora.solutions/api/v1/connectors/github/callback
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# ─── Auth login OAuth (Google / GitHub sign-in) ───────────────────────────────
# Separate from connector OAuth. Identity scopes only.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_REDIRECT_URI=https://qlix.exora.solutions/api/v1/auth/oauth/google/callback
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GITHUB_REDIRECT_URI=https://qlix.exora.solutions/api/v1/auth/oauth/github/callback

# ─── WhatsApp sidecar (optional) ─────────────────────────────────────────────
# QLIX_WHATSAPP_ENABLED=1
# QLIX_WHATSAPP_SERVICE_URL=http://localhost:3939
# QLIX_INTERNAL_SERVICE_SECRET=CHANGE_ME_SHARED_SECRET

# ─── Super-admin bootstrap (optional; disable after first run) ───────────────
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_12_CHARS_MIN
# SUPER_ADMIN_BOOTSTRAP_ALLOW_MULTIPLE=false

# =============================================================================
# FRONTEND (/var/www/qlix/frontend/.env)
# =============================================================================
# Only NEXT_PUBLIC_* vars are needed in the frontend .env.

# Same domain — nginx routes /api/ to the backend internally.
NEXT_PUBLIC_API_BASE_URL=https://qlix.exora.solutions
