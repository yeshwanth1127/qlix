# Copy to `backend/.env` and set every value. None of the signing or platform keys are hardcoded in the app.
#
# --- Process
NODE_ENV=development
PORT=4000

# Canonical public API origin — required in production for hybrid starter packs (agent.json backend_url).
# Hybrid runners on user machines connect here, not localhost.
# PUBLIC_API_URL=https://api.example.com

# Optional dev override when PUBLIC_API_URL points at host.docker.internal (cloud Docker only):
# HYBRID_RUNNER_BACKEND_URL=http://localhost:4000

# --- Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qlix?schema=public

# --- Session (HS256, min 16 characters)
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING_MIN_32_CHARS

# --- Browser / CORS (must match the Next.js origin you open in the browser, e.g. org console on localhost)
FRONTEND_URL=http://localhost:3000
# Optional: extra allowed browser origins (comma-separated)
# CORS_ORIGINS=

# --- Session cookie
# `true` when the API is only ever used over HTTPS (e.g. deployed). For http://localhost:3000 use false.
SESSION_COOKIE_SECURE=false

# --- Platform identity (Ed25519) — signs all Verifiable Credentials; published at `/.well-known/did.json`
# Generate a new private key (32 bytes hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set QLIX_PLATFORM_DID to a stable issuer DID you publish. Example only — use your own in every environment.
QLIX_PLATFORM_DID=did:qlix:platform
# 64 hex characters (32 bytes). NEVER commit a real key. Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QLIX_PLATFORM_PRIVATE_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX

# --- Cloud agent provisioning (Docker-first)
# Required to store cloud agent private keys encrypted at rest (32 bytes).
# Accepts 64 hex chars or base64 for 32 bytes.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRETS_KEY=change-me-to-a-32-byte-random-key
# Optional: override the runner image ref and ping interval.
# QLIX_CLOUD_RUNNER_IMAGE=qlix-cloud-runner:dev
# QLIX_CLOUD_PING_INTERVAL_MS=5000
# Max parallel Docker provisions (default 1 — keeps remote host stable).
# QLIX_PROVISION_MAX_CONCURRENT=1
# Re-queue agents stuck in provisioning longer than this (ms, default 120000).
# QLIX_PROVISION_STUCK_MS=120000
# Force rebuild of the shared runner image on every boot/provision.
# QLIX_CLOUD_RUNNER_ALWAYS_BUILD=false
# Per-agent-container resource ceiling (Docker --memory / --memory-reservation / --cpus / --pids-limit).
# Every agent container ran unbounded before these existed — tune to the agent host's real capacity.
# QLIX_RUNNER_MEMORY_LIMIT=1g
# QLIX_RUNNER_MEMORY_RESERVATION=512m
# QLIX_RUNNER_CPU_LIMIT=1.5
# QLIX_RUNNER_PIDS_LIMIT=512
# Cloud runner: browser tool loop (OpenRouter tool_calls → Playwright in Docker)
# QLIX_CLOUD_TOOL_MAX_ROUNDS=15
# QLIX_CLOUD_TOOL_MAX_SECONDS=200
# Nested sub-agents (spawn_subagents / await_subagents) — off by default
# QLIX_ENABLE_SUBAGENTS=0
# QLIX_SUBAGENT_MAX_PER_RUN=8
# QLIX_SUBAGENT_MAX_PARALLEL=3
# QLIX_SUBAGENT_MAX_DEPTH=1
# Legacy fire-and-forget same-agent child runs (prefer sub-agents):
# QLIX_ENABLE_DELEGATION=0
# QLIX_SUBAGENT_MAX_ROUNDS=7
# QLIX_SUBAGENT_MAX_SECONDS=100

# --- Platform research (cloud runners — Qlix ops only, not per-user)
# Residential proxy for Agent Reach / yt-dlp (optional but recommended for YouTube).
# AGENT_REACH_PROXY=http://user:pass@residential-proxy:port
# Netscape-format cookies.txt from a dedicated research Google account (not in git).
# QLIX_PLATFORM_RESEARCH_SECRETS_DIR=/var/www/qlix/secrets
# QLIX_PLATFORM_YOUTUBE_COOKIES_PATH=/var/www/qlix/secrets/youtube-cookies.txt
# Optional Twitter research tokens (forwarded to runners when set):
# AGENT_REACH_TWITTER_AUTH_TOKEN=
# AGENT_REACH_TWITTER_CT0=
# Reddit + Xiaohongshu use file-based sessions dropped into the secrets dir above
# (registry: sdk/python/qlix/research_sources.json). Generate once on a workstation
# with a browser, then copy the file into the secrets dir:
#   Reddit:      run `rdt login`,  copy ~/.config/rdt-cli/credential.json -> secrets/reddit-credential.json
#   Xiaohongshu: QR-login via xiaohongshu-mcp, copy ~/.xhs-mcp/cookies.json  -> secrets/xiaohongshu-cookies.json
# Runners auto-mount whichever files exist; missing sources degrade gracefully.

# --- LLM proxy providers
# At least one provider is required for cloud/hybrid agents with llmMode=proxy.
# Exora gateway (OpenAI-compatible LiteLLM endpoint).
# EXORA_LLM_API_KEY=
# EXORA_LLM_BASE_URL=https://llm.exora.solutions/v1
# EXORA_LLM_ENABLED=true
# EXORA_LLM_DEFAULT_MODEL=exora-general
# EXORA_ALLOWED_MODEL_PREFIXES=exora/
# Provider used by internal jobs and new agents: exora | openrouter.
# QLIX_DEFAULT_LLM_PROVIDER=exora
#
# OpenRouter remains available as a selectable provider.
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional: override base URL if needed.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: comma-separated model prefixes allowed via proxy.
# OPENROUTER_ALLOWED_MODEL_PREFIXES=openrouter/
# Embeddings stay separate from Exora chat inference.
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Model routing (Auto): on unless set to false. Completion cache on unless false.
# QLIX_MODEL_ROUTING_ENABLED=true
# QLIX_COMPLETION_CACHE_ENABLED=true

# --- Zoho CRM connector OAuth ---
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=
# ZOHO_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/zoho/callback
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# --- Slack connector OAuth ---
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/slack/callback
# SLACK_SIGNING_SECRET=

# --- Telegram Bot API (webhook → existing agent/gateway pipeline)
# Create a bot via @BotFather. Never expose these to the frontend or logs.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=  # random string; must match setWebhook secret_token
# Shared workspace routing until telegram_user_id → qlix_user_id linking exists:
# TELEGRAM_DEFAULT_ORG_ID=
# TELEGRAM_DEFAULT_AGENT_ID=
# TELEGRAM_DEFAULT_USER_ID=
# Webhook URL: POST /api/integrations/telegram/webhook

# --- Discord connector OAuth ---
# Discord Developer Portal → OAuth2 → Redirects. Add this exact callback URL.
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/discord/callback

# --- GitHub connector OAuth (separate from AUTH_GITHUB_* login) ---
# GitHub → Settings → Developer settings → OAuth Apps. Add this callback URL.
# Scopes requested: read:user user:email repo read:org
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/github/callback

# --- Microsoft 365 connector OAuth (Entra ID / Microsoft Graph) ---
# Entra admin center → App registrations → New registration (Accounts in any org + personal).
# Authentication → Add a platform → Web → Redirect URI (must match exactly):
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/microsoft/callback
# Optional tenant: common (default) | organizations | consumers | <tenant-id>
# MICROSOFT_OAUTH_TENANT=common
# API permissions (delegated): User.Read, Mail.ReadWrite, Mail.Send,
# Calendars.ReadWrite, Files.ReadWrite.All, Contacts.ReadWrite, Tasks.ReadWrite,
# plus openid/profile/email/offline_access.

# --- Notion connector OAuth (public integration) ---
# Notion → My integrations → Public integration → OAuth Domain & URIs.
# Redirect URI must match exactly:
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/notion/callback

# --- WebAuthn / passkeys
# For http://localhost:3000 in the browser, use localhost as RP ID and the same origin you load the SPA from.
WEBAUTHN_RP_NAME=Qlix
WEBAUTHN_RP_ID=localhost
# Must include the exact SPA origin (trailing slash optional, see code normalization)
WEBAUTHN_ORIGIN=http://localhost:3000
# Or multiple (comma-separated), e.g. WEBAUTHN_ORIGINS=http://localhost:3000,https://app.example.com
# WEBAUTHN_ORIGINS=

# --- WhatsApp sidecar (qlix-whatsapp-service, multi-tenant Baileys)
# QLIX_WHATSAPP_ENABLED=1
# QLIX_WHATSAPP_SERVICE_URL=http://localhost:3939
# QLIX_INTERNAL_SERVICE_SECRET=shared-secret-with-whatsapp-service
# Users link WhatsApp per workspace under Connectors (no global OWNER_JID).

# --- First-party MCP (qlix-mcp-service) — leads / jobs / schedule
# QLIX_MCP_URL=http://127.0.0.1:3940/mcp-jobs
# QLIX_MCP_JOBS_URL=http://127.0.0.1:3940/mcp-jobs
# QLIX_MCP_SCHEDULE_URL=http://127.0.0.1:3940/mcp-schedule
# (If unset, schedule/jobs URLs are derived from QLIX_MCP_URL by swapping the path.)

# --- Gmail connector (Google OAuth2) — in-house email send/read for agents
# 1. Google Cloud Console → APIs & Services → enable the "Gmail API".
# 2. OAuth consent screen: keep it in **Testing** (external) or **Internal** (Workspace)
#    mode to avoid Google's restricted-scope security assessment for gmail.send /
#    gmail.readonly. Add each user as a test user while in Testing mode.
# 3. Credentials → Create OAuth client ID (Web application). Add the redirect URI below
#    to "Authorized redirect URIs" exactly (must match GOOGLE_OAUTH_REDIRECT_URI).
# The redirect URI points at this backend's connector callback route:
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/google/callback
# In production use your public API origin, e.g.
#   https://api.example.com/api/v1/connectors/google/callback

# --- Zoho CRM connector (OAuth2) ---
# Create a Server-based Application at https://api-console.zoho.com/
# ZOHO_OAUTH_CLIENT_ID=
# ZOHO_OAUTH_CLIENT_SECRET=
# ZOHO_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/connectors/zoho/callback
# Optional data-center accounts host (default https://accounts.zoho.com). India: https://accounts.zoho.in
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# --- Auth login OAuth (Google / GitHub sign-in) — separate from Gmail connector OAuth
# Scopes are identity-only (openid email profile / read:user user:email).
# Redirect URIs must match exactly what you register in the provider consoles.
#
# Google Cloud Console → Credentials → OAuth client (Web) → Authorized redirect URIs:
# AUTH_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# AUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback
#
# GitHub → Settings → Developer settings → OAuth Apps → Authorization callback URL:
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/github/callback

# --- Super admin bootstrap (optional; leave unset to disable)
# Min 12 characters. See createAuthRouter super-admin sign-up.
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=
# SUPER_ADMIN_BOOTSTRAP_ALLOW_MULTIPLE=false

# --- Cloudflare Browser Run (optional browser failover for cloud agents)
# Primary browser stays local Chromium/agent-browser. When that path fails
# (daemon crash, launch failure, etc.), runners connect to Browser Run over CDP.
# Token needs Browser Rendering - Edit. Creds are forwarded into runner containers.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# QLIX_BROWSER_CF_FAILOVER=1
# QLIX_BROWSER_CF_KEEP_ALIVE_MS=600000
