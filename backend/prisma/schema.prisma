// Qlix ERD — multi-tenant orgs, users, agents, append-only action log, approvals, wallets, billing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Top-level tenant. Users belong to an organization; agents usually do (`agents.org_id`), but `org_id` may be null for edge flows.
model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  /// `individual` | `organization` — chosen at signup; drives console routing and IA.
  workspaceKind String   @default("individual") @map("workspace_kind")
  plan          String   @default("free")
  createdAt     DateTime @default(now()) @map("created_at")

  users                     User[]
  agents                    Agent[]
  brainKnowledgeCollections BrainKnowledgeCollection[]
  wallets                   Wallet[]
  invitations               OrganizationInvitation[]
  successfulEvents          SuccessfulEvent[]
  failedEvents              FailedEvent[]
  usageMetricsDaily         UsageMetricDaily[]
  billingStatements         BillingStatement[]
  billingLogs               BillingLog[]
  orgRateOverrides          OrgRateOverride[]
  teams                     Team[]
  connectorAccounts         ConnectorAccount[]
  mcpServers                McpServer[]
  brainConversations        BrainConversation[]
  brainUsages               BrainUsage[]
  brainAgentProposals       BrainAgentProposal[]
  jobCandidateProfiles      JobCandidateProfile[]
  jobApplyCampaigns         JobApplyCampaign[]
  subscription              OrgSubscription?

  /// Self-hosted n8n integration (encrypted webhook secret at rest).
  n8nBaseUrl          String? @map("n8n_base_url")
  n8nWebhookSecretEnc String? @map("n8n_webhook_secret_enc")
  n8nEmailReadPath    String  @default("/webhook/qlix-email-read") @map("n8n_email_read_path")
  n8nEmailSendPath    String  @default("/webhook/qlix-email-send") @map("n8n_email_send_path")

  /// Deny-list of catalog scope ids disabled for this org (Skills page). Empty = all supported scopes enabled.
  disabledScopes String[] @default([]) @map("disabled_scopes")

  employeeSchedules EmployeeSchedule[]
  scheduledEvents   ScheduledEvent[]
  orgSkills         OrgSkill[]
  builderCanvases   BuilderCanvas[]
  nlBuilderSessions NlBuilderSession[]
}

/// Human operator; password_hash for email/password auth. public_key / biometric_ref optional for crypto/biometric flows.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  email         String   @unique
  displayName   String?  @map("display_name")
  /// `individual` | `organization` — mirrors signup choice; used for routing and authorization.
  workspaceKind String   @default("individual") @map("workspace_kind")
  /// Org RBAC: `owner` | `admin` | `member`. First signup to an org is always `owner`; invites use `admin` or `member` only.
  role          String
  /// Platform-level privilege for internal operations (not org RBAC).
  isSuperAdmin  Boolean  @default(false) @map("is_super_admin")
  publicKey     String?  @map("public_key")
  biometricRef  String?  @map("biometric_ref")
  /// Null for OAuth-only accounts (Google / GitHub) that never set a password.
  passwordHash  String?  @map("password_hash")
  isActive      Boolean  @default(true) @map("is_active")
  /// Auto-provisioned exploration account (chat-first landing). Claimable via /auth/claim.
  isGuest       Boolean  @default(false) @map("is_guest")
  createdAt     DateTime @default(now()) @map("created_at")

  /// Passkey / WebAuthn: credential id (base64url), stored after successful registration verify.
  webauthnCredentialId String? @map("webauthn_credential_id")
  /// COSE public key bytes encoded as base64url for later authentication verification.
  webauthnPublicKey    String? @map("webauthn_public_key")
  webauthnCounter      Int     @default(0) @map("webauthn_counter")
  deviceVerified       Boolean @default(false) @map("device_verified")

  organization       Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agents             Agent[]
  agentConversations AgentConversation[]
  brainConversations BrainConversation[]
  brainUsages        BrainUsage[]
  brainAgentProposals BrainAgentProposal[]
  agentMemories      AgentMemory[]
  actionLogs         ActionLog[]
  approvals          Approval[]
  wallets            Wallet[]
  invitationsSent    OrganizationInvitation[] @relation("InvitationInviter")
  successfulEvents   SuccessfulEvent[]
  failedEvents       FailedEvent[]
  teamsCreated       Team[]                   @relation("TeamsCreated")
  teamRunsStarted    TeamRun[]                @relation("TeamRunsStarted")
  connectorAccounts  ConnectorAccount[]
  nlBuilderHistory   NlBuilderHistory[]
  nlBuilderSessions  NlBuilderSession[]
  jobCandidateProfiles JobCandidateProfile[]  @relation("JobCandidateProfileOwner")
  jobApplyCampaigns  JobApplyCampaign[]       @relation("JobApplyCampaignCreator")
  apiKeys            ApiKey[]
  mcpServersCreated  McpServer[]
  oauthAccounts      OAuthAccount[]
  employeeEngagementsHired EmployeeEngagement[] @relation("EmployeeHiredBy")
  builderCanvases    BuilderCanvas[]          @relation("BuilderCanvasCreator")

  @@index([orgId])
  @@map("users")
}

/// Linked Google / GitHub identities for passwordless sign-in.
model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// `google` | `github`
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// OAuth connector account (Google Gmail for email.read / email.send).
model ConnectorAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  orgId                  String    @map("org_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  provider               String
  /// `connected` | `revoked` | `error`
  status                 String    @default("connected")
  scopes                 String[]  @default([])
  emailAddress           String?   @map("email_address")
  /// Baileys owner JID (`919876543210@s.whatsapp.net`) when provider is `whatsapp_baileys`.
  whatsappOwnerJid       String?   @map("whatsapp_owner_jid")
  /// Default agent for inbound WhatsApp commands for this workspace.
  whatsappDefaultAgentId String?   @map("whatsapp_default_agent_id")
  /// Default team for inbound WhatsApp when message has no @TeamName prefix.
  whatsappDefaultTeamId  String?   @map("whatsapp_default_team_id")
  tokenEnc               String    @map("token_enc")
  tokenExpiresAt         DateTime? @map("token_expires_at")
  connectedAt            DateTime  @default(now()) @map("connected_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@index([userId])
  @@map("connector_accounts")
}

/// Pending agent-picker state when WhatsApp intent routing is ambiguous (one row per connector).
model WhatsAppPendingRoute {
  connectorId String   @id @map("connector_id") @db.Uuid
  prompt      String
  brainFlag   Boolean  @default(false) @map("brain_flag")
  optionsJson Json     @map("options_json")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("whatsapp_pending_routes")
}

/// Pending agent-picker for Telegram (one row per connector + chat).
model TelegramPendingRoute {
  id          String   @id @default(uuid()) @db.Uuid
  connectorId String   @map("connector_id") @db.Uuid
  chatId      String   @map("chat_id")
  prompt      String
  brainFlag   Boolean  @default(false) @map("brain_flag")
  optionsJson Json     @map("options_json")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([connectorId, chatId])
  @@index([expiresAt])
  @@map("telegram_pending_routes")
}

/// Shared claim log so cluster workers do not double-process the same Update.
model TelegramUpdateClaim {
  updateId  BigInt   @id @map("update_id")
  claimedAt DateTime @default(now()) @map("claimed_at")

  @@index([claimedAt])
  @@map("telegram_update_claims")
}

/// Active listen session: contact replies auto-route to the agent that messaged them.
model WhatsAppAutoReplySession {
  id            String    @id @default(cuid())
  connectorId   String    @map("connector_id") @db.Uuid
  agentId       String    @map("agent_id")
  contactJid    String    @map("contact_jid")
  contactName   String?   @map("contact_name")
  contactPhone  String?   @map("contact_phone")
  /// What the agent should do when this contact replies (set via tool / send).
  replyInstructions String? @map("reply_instructions") @db.Text
  /// `active` | `stopped` | `expired`
  status        String    @default("active")
  expiresAt     DateTime  @map("expires_at")
  lastOutboundAt DateTime @default(now()) @map("last_outbound_at")
  lastInboundAt DateTime? @map("last_inbound_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([connectorId, contactJid])
  @@index([connectorId, status, expiresAt])
  @@index([agentId, status])
  @@map("whatsapp_auto_reply_sessions")
}

/// Email invite to join an organization workspace (`admin` or `member` only). Token is stored hashed.
model OrganizationInvitation {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  email           String
  /// Invited role: `admin` | `member` only (never `owner`).
  role            String
  tokenHash       String   @map("token_hash")
  expiresAt       DateTime @map("expires_at")
  invitedByUserId String   @map("invited_by_user_id") @db.Uuid
  /// `pending` | `accepted` | `revoked` | `expired`
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([tokenHash])
  @@index([orgId, email])
  @@map("organization_invitations")
}

/// AI agent with DID and keys. `id` is a cuid string (references from action log / billing use text FKs).
model Agent {
  id     String  @id @default(cuid())
  userId String  @map("user_id") @db.Uuid
  /// Usually the owner org; optional when an agent is not yet tied to an org.
  orgId  String? @map("org_id") @db.Uuid

  name      String
  did       String @unique
  publicKey String @map("public_key")
  status    String @default("active")

  runtime            String  @default("cloud")
  /// DB column `model` — default LLM / runtime label (Prisma field cannot be named `model`).
  llmModel           String  @default("openrouter/qlix/auto") @map("model")
  /// Where LLM calls go: `direct` (local engine / OpenRouter) or `proxy` (through Qlix backend).
  /// Constraint enforced in service layer: runtime=cloud + llmMode=direct is invalid.
  llmMode            String  @default("proxy") @map("llm_mode")
  /// Hosted inference provider used when `llmMode` is `proxy`: `exora` | `openrouter`.
  llmProvider        String  @default("exora") @map("llm_provider")
  /// When `runtime` is `local`: `local_llm` vs `cloud_api`. Null when `runtime` is `cloud`.
  localInferenceMode String? @map("local_inference_mode")
  /// How much of the completion budget a thinking model may spend reasoning:
  /// `none` | `minimal` | `low` | `medium` | `high` | `xhigh` | `max`.
  /// Null lets Qlix pick a small share, which keeps room for the visible answer.
  reasoningEffort    String? @map("reasoning_effort")

  permissionScopes String[] @default([]) @map("permission_scopes")
  jitScopes        String[] @default([]) @map("jit_scopes")
  alwaysScopes     String[] @default([]) @map("always_scopes")

  /// Cloud runner provisioning state for `runtime = cloud`.
  /// `provisioning` | `running` | `failed` | `stopped`
  cloudProvisioningStatus String?   @map("cloud_provisioning_status")
  /// Docker container name/id (dev target). Null for non-cloud or not yet provisioned.
  cloudRunnerId           String?   @map("cloud_runner_id")
  /// Last heartbeat timestamp from cloud runner (set by /api/v1/agents/:did/ping).
  cloudLastHeartbeatAt    DateTime? @map("cloud_last_heartbeat_at")
  /// Encrypted private key (Ed25519 seed) for cloud runtime only; never returned to browser.
  cloudPrivateKeyEnc      String?   @map("cloud_private_key_enc")
  /// Last provisioning error/debug message (safe for UI; keep short, no secrets).
  cloudProvisioningError  String?   @map("cloud_provisioning_error")
  /// Encrypted runner auth token (for runner → backend polling/log/complete in Docker-dev).
  cloudRunnerTokenEnc     String?   @map("cloud_runner_token_enc")

  /// Hybrid runner: HMAC-SHA256 hash of the one-time runner token issued at creation.
  hybridRunnerTokenHash String?   @map("hybrid_runner_token_hash")
  /// Hybrid runner: last heartbeat timestamp from the user's local daemon.
  hybridLastHeartbeatAt DateTime? @map("hybrid_last_heartbeat_at")

  /// Device-bound passkey credential id for this agent (base64url), when enforcing per-agent WebAuthn.
  webauthnCredentialId String?   @map("webauthn_credential_id")
  keypairDeliveredAt   DateTime? @map("keypair_delivered_at")
  lastConnectedAt      DateTime? @map("last_connected_at")

  /// `standard` | `org_brain` — at most one `org_brain` per tenant org (enforced in service layer).
  agentKind String @default("standard") @map("agent_kind")

  /// Optional free-text description that becomes the ADK system prompt context.
  description String? @map("description")

  /// Agent billing tier: `free` | `paid`. Defaults to `free`.
  agentTier String @default("free") @map("agent_tier")

  /// Tool visibility profile: `minimal` | `coding` | `full` (OpenClaw-style).
  toolProfile String @default("full") @map("tool_profile")

  createdAt  DateTime  @default(now()) @map("created_at")
  lastActive DateTime? @map("last_active")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actionLogs       ActionLog[]
  successfulEvents SuccessfulEvent[]
  failedEvents     FailedEvent[]
  credentials      VerifiableCredential[]
  conversations    AgentConversation[]
  runs             AgentRun[]
  memories         AgentMemory[]
  runUsages        RunUsage[]
  supervisedTeams  Team[]                 @relation("TeamSupervisor")
  teamMemberships  TeamMember[]
  mcpBindings      AgentMcpBinding[]
  employeeEngagement EmployeeEngagement?
  schedules        EmployeeSchedule[]
  scheduledEvents  ScheduledEvent[]      @relation("ScheduledEventTarget")
  createdSchedules ScheduledEvent[]      @relation("ScheduledEventCreator")
  orgSkills        OrgSkill[]
  brainConversations BrainConversation[] @relation("BrainAgentConversations")
  brainUsages        BrainUsage[]
  brainAgentProposals BrainAgentProposal[] @relation("BrainAgentProposals")
  subAgentInvocations SubAgentInvocation[]
  whatsappAutoReplySessions WhatsAppAutoReplySession[]

  @@index([orgId])
  @@index([userId])
  @@map("agents")
}

/// Product record for a hired AI Employee — links a standard Agent to a versioned role pack snapshot.
model EmployeeEngagement {
  id              String    @id @default(cuid())
  agentId         String    @unique @map("agent_id")
  workspaceOrgId  String    @map("workspace_org_id") @db.Uuid
  hiredByUserId   String    @map("hired_by_user_id") @db.Uuid
  roleSlug        String    @map("role_slug")
  packVersion     String    @map("pack_version")
  packHash        String    @map("pack_hash")
  packSnapshot    Json      @map("pack_snapshot")
  configOverrides Json      @default("{}") @map("config_overrides")
  /// `active` | `suspended` | `replaced` | `archived`
  status          String    @default("active")
  hiredAt         DateTime  @default(now()) @map("hired_at")
  suspendedAt     DateTime? @map("suspended_at")
  terminatedAt    DateTime? @map("terminated_at")
  replacedById    String?   @map("replaced_by_id")

  agent   Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  hiredBy User  @relation("EmployeeHiredBy", fields: [hiredByUserId], references: [id], onDelete: Cascade)
  schedules EmployeeSchedule[]

  @@index([workspaceOrgId])
  @@index([roleSlug])
  @@index([status])
  @@map("employee_engagements")
}

/// A registered MCP (Model Context Protocol) server, org-scoped. Its tools are consumed by
/// agents under full Qlix governance (scopes + JIT + signed audit ledger + pay-per-success).
model McpServer {
  id                         String    @id @default(uuid()) @db.Uuid
  orgId                      String    @map("org_id") @db.Uuid
  createdByUserId            String    @map("created_by_user_id") @db.Uuid
  /// URL-safe id used in scope + actionType strings: `mcp.<slug>.<tool>`. Unique per org.
  slug                       String
  name                       String
  description                String    @default("")
  /// `http` (Streamable HTTP — cloud + hybrid) | `stdio` (local subprocess — hybrid only).
  transport                  String    @default("http")
  /// http transport: endpoint URL.
  endpointUrl                String?   @map("endpoint_url")
  /// stdio transport: executable path/name.
  command                    String?
  /// stdio transport: command arguments.
  args                       String[]  @default([])
  /// `none` | `header` | `oauth`
  authType                   String    @default("none") @map("auth_type")
  /// Encrypted JSON `{ headers?, env?, token? }` (AES-256-GCM via AGENT_SECRETS_KEY). Never sent to the browser.
  secretEnc                  String?   @map("secret_enc")
  /// `connected` | `error` | `revoked` | `pending`
  status                     String    @default("pending")
  protocolVersion            String?   @map("protocol_version")
  serverInfo                 Json?     @map("server_info")
  lastError                  String?   @map("last_error")
  lastDiscoveredAt           DateTime? @map("last_discovered_at")
  enabled                    Boolean   @default(true)
  // ---- OAuth (authType = 'oauth') — discovered/registered metadata. Tokens + clientSecret
  // live in the encrypted secretEnc JSON under `oauth`, never in plain columns. ----
  oauthIssuer                String?   @map("oauth_issuer")
  oauthAuthorizationEndpoint String?   @map("oauth_authorization_endpoint")
  oauthTokenEndpoint         String?   @map("oauth_token_endpoint")
  oauthRegistrationEndpoint  String?   @map("oauth_registration_endpoint")
  /// RFC 8707 resource indicator (the protected MCP resource URL).
  oauthResource              String?   @map("oauth_resource")
  oauthClientId              String?   @map("oauth_client_id")
  oauthScope                 String?   @map("oauth_scope")
  /// Extra authorization-request query params as `k=v&k2=v2` (e.g. Google's
  /// `access_type=offline&prompt=consent`, required to obtain a refresh token).
  oauthAuthParams            String?   @map("oauth_auth_params")
  /// True once a token has been obtained and not revoked.
  oauthConnected             Boolean   @default(false) @map("oauth_connected")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  tools         McpServerTool[]
  bindings      AgentMcpBinding[]
  oauthSessions McpOAuthSession[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("mcp_servers")
}

/// In-flight OAuth authorization-code+PKCE dance. One row per "Connect" click; consumed
/// (and deleted) by the callback. `state` is the single-use CSRF/lookup key.
model McpOAuthSession {
  id              String   @id @default(uuid()) @db.Uuid
  mcpServerId     String   @map("mcp_server_id") @db.Uuid
  state           String   @unique
  codeVerifier    String   @map("code_verifier")
  redirectUri     String   @map("redirect_uri")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  expiresAtMs     BigInt   @map("expires_at_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  server McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@index([mcpServerId])
  @@map("mcp_oauth_sessions")
}

/// Cached tool catalog from an MCP server's `tools/list`, with governance derived from annotations.
model McpServerTool {
  id                 String   @id @default(uuid()) @db.Uuid
  mcpServerId        String   @map("mcp_server_id") @db.Uuid
  name               String
  description        String   @default("")
  inputSchema        Json?    @map("input_schema")
  annotations        Json?
  /// `low` | `medium` | `high` — derived from annotations (readOnlyHint / destructiveHint).
  riskLevel          String   @default("low") @map("risk_level")
  /// `auto` | `jit` | `blocked` — default governance applied when binding the tool to an agent.
  defaultGovernance  String   @default("auto") @map("default_governance")
  /// sha256(name + description + inputSchema) of the currently-advertised definition.
  definitionHash     String   @map("definition_hash")
  /// Last admin-approved definitionHash. Mismatch ⇒ re-approval required (tool-poisoning guard).
  approvedHash       String?  @map("approved_hash")
  /// Snapshot `{ description, inputSchema }` of the approved definition, kept so the UI can
  /// show a before/after diff when a server later changes (poisons) the tool.
  approvedDefinition Json?    @map("approved_definition")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  server McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([mcpServerId, name])
  @@index([mcpServerId])
  @@map("mcp_server_tools")
}

/// Binds an MCP server to an agent and records which of its tools the agent may use.
/// The matching `mcp.<slug>.<tool>` scopes are written onto the Agent's permission/jit scopes.
model AgentMcpBinding {
  id           String   @id @default(uuid()) @db.Uuid
  agentId      String   @map("agent_id")
  mcpServerId  String   @map("mcp_server_id") @db.Uuid
  /// Allowed tool names, or `["*"]` for every tool on the server.
  allowedTools String[] @default([]) @map("allowed_tools")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agent  Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  server McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@unique([agentId, mcpServerId])
  @@index([agentId])
  @@index([mcpServerId])
  @@map("agent_mcp_bindings")
}

model AgentConversation {
  id              String   @id @default(cuid())
  agentId         String   @map("agent_id")
  userId          String   @map("user_id") @db.Uuid
  orgId           String?  @map("org_id") @db.Uuid
  /// Display title (web / local terminal chat list).
  title           String?
  /// `chat` (default web) or `local` (terminal threads).
  kind            String   @default("chat")
  /// Fork parent when created via /fork.
  parentConversationId String? @map("parent_conversation_id")
  /// Stable gateway session key for cross-channel routing (optional).
  sessionKey      String?  @map("session_key")
  /// Stage 2 compaction: rolling summary of messages older than the recent window.
  /// Hard-capped (~2000 chars) and re-compressed on each update, so it can't snowball.
  summary         String?  @db.Text
  /// How many of this conversation's messages are already folded into `summary`.
  summarizedCount Int      @default(0) @map("summarized_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         AgentConversation?  @relation("ConversationForks", fields: [parentConversationId], references: [id], onDelete: SetNull)
  forks          AgentConversation[] @relation("ConversationForks")
  messages       AgentMessage[]
  runs           AgentRun[]
  jitScopeGrants JitScopeGrant[]

  @@index([agentId, userId])
  @@index([agentId])
  @@index([userId])
  @@index([sessionKey])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  /// Chat file attachments: [{ id, fileName, mimeType, url, sizeBytes, textPreview? }]
  attachments    Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   AgentConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  brainCitations BrainKnowledgeCitation[]

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model BrainConversation {
  id           String   @id @default(cuid())
  brainAgentId String   @map("brain_agent_id")
  userId       String   @map("user_id") @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  title        String   @default("New chat") @db.VarChar(160)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  brainAgent Agent                      @relation("BrainAgentConversations", fields: [brainAgentId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages   BrainConversationMessage[]
  proposals  BrainAgentProposal[]

  @@index([userId, orgId, updatedAt])
  @@index([brainAgentId])
  @@map("brain_conversations")
}

/// Pending agent/team plan from exa; DID/VC create only after user confirm.
model BrainAgentProposal {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id") @db.Uuid
  brainAgentId    String    @map("brain_agent_id")
  conversationId  String?   @map("conversation_id")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  /// `pending` | `confirmed` | `rejected` | `expired`
  status          String    @default("pending")
  planJson        Json      @map("plan_json")
  rationale       String    @default("") @db.Text
  primaryAgentId  String?   @map("primary_agent_id")
  createdAgentIds String[]  @default([]) @map("created_agent_ids")
  teamId          String?   @map("team_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  resolvedAt      DateTime? @map("resolved_at")

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  brainAgent   Agent             @relation("BrainAgentProposals", fields: [brainAgentId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  conversation BrainConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([conversationId])
  @@index([brainAgentId])
  @@map("brain_agent_proposals")
}

model BrainConversationMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  citations      Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation BrainConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("brain_conversation_messages")
}

/// Token usage recorded for Exa brain queries, which do not run through AgentRun.
/// Kept after the brain agent is deleted (`SetNull` on FK); `agentKey` / `agentName` are durable snapshots.
model BrainUsage {
  id               String   @id @default(cuid())
  /// Live FK — null after the Agent row is deleted.
  brainAgentId     String?  @map("brain_agent_id")
  /// Durable agent id for grouping after delete (never cleared).
  agentKey         String   @map("agent_key")
  /// Display name captured when usage was recorded.
  agentName        String   @map("agent_name") @db.VarChar(160)
  userId           String   @map("user_id") @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  totalCostUsd     Decimal  @default(0) @map("total_cost_usd") @db.Decimal(18, 8)
  model            String?
  provider         String?
  createdAt        DateTime @default(now()) @map("created_at")

  brainAgent Agent?       @relation(fields: [brainAgentId], references: [id], onDelete: SetNull)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([brainAgentId, createdAt])
  @@index([agentKey, createdAt])
  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@map("brain_usages")
}

/// Stage 1 agent memory: durable items remembered per agent + per user.
/// `kind` is `fact` (semantic — things known about the user), `episode` (episodic —
/// what happened in a past run), or `recipe` (procedural — an approach that worked).
/// Plain text, no embeddings. Working memory reuses AgentMessage and is not stored here.
model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  userId    String   @map("user_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  /// `fact` | `episode` | `recipe`
  kind      String
  content   String   @db.Text
  /// `auto` (extracted after a run) | `manual` (entered explicitly)
  source    String   @default("auto")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId, userId, kind, createdAt])
  @@map("agent_memories")
}

/// Org-scoped knowledge collection for the AI Brain (RAG sources).
model BrainKnowledgeCollection {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id") @db.Uuid
  name          String
  description   String   @default("")
  /// Optional retention in days; null = platform default in app layer.
  retentionDays Int?     @map("retention_days")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents    BrainKnowledgeDocument[]
  citations    BrainKnowledgeCitation[]

  @@index([orgId])
  @@map("brain_knowledge_collections")
}

/// Document ingested into a brain collection.
/// File uploads retain the original binary (storageKey) AND extract text into
/// bodyText + chunks + embeddings for the normal RAG workflow.
model BrainKnowledgeDocument {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id") @db.Uuid
  collectionId String   @map("collection_id")
  title        String
  /// Raw source text for MVP ingest; external URI optional for future connectors.
  bodyText     String   @map("body_text") @db.Text
  sourceUri    String?  @map("source_uri")
  /// Original upload filename (when a binary was retained for download/send).
  originalFileName String? @map("original_file_name")
  /// MIME type of the retained original upload.
  originalMimeType String? @map("original_mime_type")
  /// Relative path under the brain-files root (orgId/docId/filename).
  storageKey   String?  @map("storage_key")
  /// `pending` | `ready` | `failed`
  ingestStatus String   @default("pending") @map("ingest_status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection BrainKnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  chunks     BrainKnowledgeChunk[]
  citations  BrainKnowledgeCitation[]

  @@index([orgId])
  @@index([collectionId])
  @@map("brain_knowledge_documents")
}

model BrainKnowledgeChunk {
  id             String  @id @default(cuid())
  orgId          String  @map("org_id") @db.Uuid
  documentId     String  @map("document_id")
  ordinal        Int
  textContent    String  @map("text_content") @db.Text
  /// Populated when embedding pipeline exists.
  embeddingModel String? @map("embedding_model")
  /// Float array stored as JSON; populated async after ingest via OpenRouter embeddings.
  embeddingVec   Json?   @map("embedding_vec")

  document BrainKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([orgId])
  @@map("brain_knowledge_chunks")
}

/// Citation from retrieved knowledge to an agent message (auditability).
model BrainKnowledgeCitation {
  id             String   @id @default(cuid())
  orgId          String   @map("org_id") @db.Uuid
  agentMessageId String?  @map("agent_message_id")
  collectionId   String   @map("collection_id")
  documentId     String   @map("document_id")
  chunkOrdinal   Int      @default(0) @map("chunk_ordinal")
  excerpt        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  message    AgentMessage?            @relation(fields: [agentMessageId], references: [id], onDelete: SetNull)
  collection BrainKnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  document   BrainKnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([agentMessageId])
  @@map("brain_knowledge_citations")
}

model AgentRun {
  id             String    @id @default(cuid())
  agentId        String    @map("agent_id")
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id") @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  status         String    @default("queued")
  prompt         String
  /// File attachments for this run (same shape as AgentMessage.attachments).
  attachments    Json?
  skills         String[]  @default([])
  /// Normalized OpenRouter model id for proxy inference (`openrouter/provider/model`). Null = runner manifest default.
  inferenceModel String?   @map("inference_model")
  /// Per-run thinking share. Null uses the agent's saved preference or Qlix's small default.
  reasoningEffort String?  @map("reasoning_effort")
  /// When true, cloud runner prepends org brain context before proxy inference.
  useBrain       Boolean   @default(false) @map("use_brain")
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  result         Json?
  errorMessage   String?   @map("error_message")
  /// Set when run is enqueued by team orchestration.
  teamRunId      String?   @map("team_run_id")
  teamId         String?   @map("team_id")
  /// supervisor | worker — role within the team run.
  teamRole       String?   @map("team_role")
  /// Where this run was started: `web` | `api` | `whatsapp` | `slack` | `telegram` | `local` | `cron`.
  sourceChannel  String    @default("web") @map("source_channel")
  /// When set, final run result is delivered to this WhatsApp contact JID (auto-reply).
  whatsappReplyToJid String? @map("whatsapp_reply_to_jid")
  /// Parent AgentRun when this run is a child of another run (V2 child runs; optional in V1).
  parentRunId String? @map("parent_run_id")
  /// How this run was created: `user` | `subagent` | `team_worker` | null (legacy).
  invocationKind String? @map("invocation_kind")

  agent        Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events       AgentRunEvent[]
  usage        RunUsage?
  teamRun      TeamRun?          @relation(fields: [teamRunId], references: [id], onDelete: SetNull)
  a2aTask      A2ATask?
  parentRun    AgentRun?         @relation("AgentRunParentChild", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns    AgentRun[]        @relation("AgentRunParentChild")
  subAgentInvocations SubAgentInvocation[] @relation("SubAgentParentRun")
  asChildInvocation   SubAgentInvocation?  @relation("SubAgentChildRun")

  @@index([agentId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@index([teamRunId])
  @@index([parentRunId])
  @@map("agent_runs")
}

/// Mid-run sub-agent fan-out: logical children of a parent AgentRun (V1 nested; V2 may set childAgentId).
model SubAgentInvocation {
  id            String    @id @default(cuid())
  parentRunId   String    @map("parent_run_id")
  parentAgentId String    @map("parent_agent_id")
  /// Reserved for V2 separate-identity sub-agents; null in V1 nested mode.
  childAgentId  String?   @map("child_agent_id")
  /// Optional AgentRun created for audit; null when nested in-process (V1).
  childRunId    String?   @unique @map("child_run_id")
  name          String?
  prompt        String
  skills        String[]  @default([])
  /// Nesting depth (parent user run = 0; first-level children = 1).
  depth         Int       @default(1)
  /// queued | running | completed | failed | canceled
  status        String    @default("queued")
  result        Json?
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  parentRun   AgentRun  @relation("SubAgentParentRun", fields: [parentRunId], references: [id], onDelete: Cascade)
  parentAgent Agent     @relation(fields: [parentAgentId], references: [id], onDelete: Cascade)
  childRun    AgentRun? @relation("SubAgentChildRun", fields: [childRunId], references: [id], onDelete: SetNull)

  @@index([parentRunId, status])
  @@index([parentAgentId, createdAt])
  @@map("sub_agent_invocations")
}

model AgentRunEvent {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  seq       Int
  type      String   @map("type")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, createdAt])
  @@map("agent_run_events")
}

/// Token usage and cost tracking for completed agent runs. One row per run; data sourced from OpenRouter inference events.
/// Kept after the Agent / AgentRun rows are deleted (`SetNull` on FKs); `agentKey` / `agentName` are durable snapshots
/// so the usage page still attributes tokens after an agent is removed.
model RunUsage {
  id               String   @id @default(cuid())
  /// Live FK to the run — null after the AgentRun row is cascade-deleted with the agent.
  runId            String?  @unique @map("run_id")
  /// Live FK — null after the Agent row is deleted.
  agentId          String?  @map("agent_id")
  /// Durable agent id for grouping after delete (never cleared).
  agentKey         String   @map("agent_key")
  /// Display name captured when usage was recorded.
  agentName        String   @map("agent_name") @db.VarChar(160)
  orgId            String?  @map("org_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  totalCostUsd     Decimal  @default(0) @map("total_cost_usd") @db.Decimal(18, 8)
  model            String?
  provider         String?
  openrouterGenId  String?  @map("openrouter_gen_id")
  createdAt        DateTime @default(now()) @map("created_at")

  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  agent Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([agentKey, createdAt])
  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@map("run_usages")
}

/// Verifiable Credential issued by the Qlix platform to an agent.
/// Two are issued at agent creation: `identity` (humanVerified+deviceVerified) and `scope` (permission/jit/always).
/// `claims` is the canonical JSON the signature was computed over; `signature` is the platform Ed25519 signature.
/// `agentId` is nullable with `SetNull` on delete — `agentDid` is kept alongside so the
/// credential remains identifiable even after the issuing Agent row is gone.
model VerifiableCredential {
  id         String    @id @default(cuid())
  agentId    String?   @map("agent_id")
  agentDid   String    @map("agent_did")
  /// `identity` | `scope` | `jit`
  type       String
  issuerDid  String    @map("issuer_did")
  subjectDid String    @map("subject_did")
  claims     Json
  signature  String
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([agentDid])
  @@index([type])
  @@map("verifiable_credentials")
}

/// Append-only audit trail. Never update or delete rows in application code.
/// `agentId` is nullable with `SetNull` on delete — deleting an agent must never
/// erase its signed action history, only detach it from the (now-gone) Agent row.
model ActionLog {
  id             String  @id @default(uuid()) @db.Uuid
  agentId        String? @map("agent_id")
  userId         String  @map("user_id") @db.Uuid
  actionType     String  @map("action_type")
  payload        Json
  riskLevel      String  @map("risk_level")
  status         String
  approvalStatus String  @map("approval_status")
  signature      String
  prevHash       String  @map("prev_hash")
  timestampMs    BigInt  @map("timestamp_ms")

  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approval     Approval?
  transactions Transaction[]

  @@index([timestampMs])
  @@index([agentId, timestampMs])
  @@map("action_logs")
}

/// Lifecycle for human approval of an action (pending / decided / timeout).
model Approval {
  id            String  @id @default(uuid()) @db.Uuid
  actionLogId   String  @unique @map("action_log_id") @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  decision      String
  pushToken     String? @map("push_token")
  /// One-time token returned to the SDK when a JIT request is approved; cleared after /actions/start consumes it.
  jitToken      String? @map("jit_token")
  requestedAtMs BigInt  @map("requested_at_ms")
  decidedAtMs   BigInt? @map("decided_at_ms")
  ttlSeconds    Int     @map("ttl_seconds")

  actionLog ActionLog @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

/// Durable per-conversation approval grant ("approve once per session"). One human
/// "yes" to a JIT scope (e.g. `email.send`) auto-approves every later use of that
/// scope in the same conversation, until revoked or the safety TTL lapses. Each
/// individual action is still minted + written to the action log; only the repeat
/// prompting is suppressed. Generalizes the in-memory run-scoped grant in jit.service.
model JitScopeGrant {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id")
  agentId         String    @map("agent_id")
  /// The actionType this grant covers, e.g. "email.send".
  scope           String
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Safety expiry; refreshed each time the grant auto-approves a request. Null = no expiry.
  expiresAt       DateTime? @map("expires_at")
  /// Set when a user revokes the grant from the dashboard.
  revokedAt       DateTime? @map("revoked_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, scope])
  @@index([conversationId])
  @@index([agentId])
  @@map("jit_scope_grants")
}

/// One wallet per user (individual credits) or per org (enterprise prepaid). Exactly one of user_id / org_id is set.
/// balance is kept as a denormalized aggregate (freeBalance + paidBalance) for backward-compat reads.
model Wallet {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @unique @map("user_id") @db.Uuid
  orgId         String?   @unique @map("org_id") @db.Uuid
  /// Denormalized aggregate: freeBalance + paidBalance. Updated whenever either bucket changes.
  balance       Decimal   @default(0) @db.Decimal(18, 8)
  /// Expiring monthly free credit from subscription (zeroed on renewal).
  freeBalance   Decimal   @default(0) @map("free_balance") @db.Decimal(18, 8)
  /// User-topped-up paid credit — never expires.
  paidBalance   Decimal   @default(0) @map("paid_balance") @db.Decimal(18, 8)
  /// When the current freeBalance expires (end of current billing period).
  freeExpiresAt DateTime? @map("free_expires_at")
  currency      String    @default("INR")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

/// Billing ledger entry tied to a wallet and optionally to the action that triggered it.
model Transaction {
  id                String   @id @default(uuid()) @db.Uuid
  walletId          String   @map("wallet_id") @db.Uuid
  actionLogId       String?  @map("action_log_id") @db.Uuid
  successfulEventId String?  @map("successful_event_id") @db.Uuid
  type              String
  amount            Decimal  @db.Decimal(18, 8)
  status            String
  /// Which credit bucket was affected: "free" | "paid" | null (for debits that spanned both, null = aggregate).
  creditKind        String?  @map("credit_kind")
  createdAt         DateTime @default(now()) @map("created_at")

  wallet          Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  actionLog       ActionLog?       @relation(fields: [actionLogId], references: [id], onDelete: SetNull)
  successfulEvent SuccessfulEvent? @relation(fields: [successfulEventId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@map("transactions")
}

/// Billable product surface (Passport, Audit, …). One global price per service key; ingest `eventType` maps here (with optional legacy aliases).
model BillingService {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable key sent on ingest after canonicalization (e.g. passport, audit).
  serviceKey  String   @unique @map("service_key")
  displayName String   @map("display_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 8)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("billing_services")
}

/// Plan pricing definition. name must match Organization.plan values.
model PricingTier {
  id                String   @id @default(uuid()) @db.Uuid
  /// Must match Organization.plan values: "free" | "starter" | "growth" | "business" | "custom".
  name              String   @unique
  /// Monthly subscription price in INR.
  monthlyPrice      Decimal  @map("monthly_price") @db.Decimal(18, 8)
  includedSuccesses Int      @default(0) @map("included_successes")
  /// Fallback per-success price when an event type lacks an explicit rate.
  overageRate       Decimal  @map("overage_rate") @db.Decimal(18, 8)
  description       String?
  /// Maximum number of agents this plan allows (0 = unlimited for custom).
  maxAgents         Int      @default(0) @map("max_agents")
  /// Free credit (INR) auto-deposited to freeBalance on each monthly renewal.
  freeMonthlyCredit Decimal  @default(0) @map("free_monthly_credit") @db.Decimal(18, 8)
  /// Model tier keys this plan grants access to (e.g. ["economy","standard"]).
  allowedModelTiers String[] @default([]) @map("allowed_model_tiers")
  /// Maximum inbound WhatsApp messages per billing cycle (0 = plan has no WhatsApp).
  whatsappMsgLimit  Int      @default(0) @map("whatsapp_msg_limit")
  createdAt         DateTime @default(now()) @map("created_at")

  eventRates EventRate[]

  @@map("pricing_tiers")
}

/// Tier-level price for a specific event type (e.g. pro + passport_verify = $0.05).
model EventRate {
  id            String   @id @default(uuid()) @db.Uuid
  pricingTierId String   @map("pricing_tier_id") @db.Uuid
  eventType     String   @map("event_type")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(18, 8)
  createdAt     DateTime @default(now()) @map("created_at")

  pricingTier PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)

  @@unique([pricingTierId, eventType])
  @@index([eventType])
  @@map("event_rates")
}

/// Org-specific override for an event type, time-bounded (null effectiveTo = ongoing).
model OrgRateOverride {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  eventType     String    @map("event_type")
  unitPrice     Decimal   @map("unit_price") @db.Decimal(18, 8)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, eventType, effectiveFrom])
  @@map("org_rate_overrides")
}

/// A successful, billable (or included/free) event for pay-per-success.
model SuccessfulEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  agentId            String?  @map("agent_id")
  eventType          String   @map("event_type")
  /// Computed server-side (0 for included successes).
  amountCharged      Decimal  @map("amount_charged") @db.Decimal(18, 8)
  billingCycle       String   @map("billing_cycle")
  /// Idempotency key unique per org (required for ingest).
  successfulEventKey String   @map("successful_event_key")
  eventData          Json?    @map("event_data")
  apiEndpoint        String?  @map("api_endpoint")
  httpStatusCode     Int?     @map("http_status_code")
  responseTimeMs     Int?     @map("response_time_ms")
  occurredAt         DateTime @map("occurred_at")
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([orgId, successfulEventKey])
  @@index([orgId, occurredAt])
  @@index([orgId, billingCycle])
  @@index([billingCycle])
  @@index([eventType, occurredAt])
  @@map("successful_events")
}

/// Failed event captured for troubleshooting (no charge).
model FailedEvent {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  agentId        String?  @map("agent_id")
  eventType      String   @map("event_type")
  errorMessage   String?  @map("error_message")
  errorCode      String?  @map("error_code")
  requestData    Json?    @map("request_data")
  apiEndpoint    String?  @map("api_endpoint")
  httpStatusCode Int?     @map("http_status_code")
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([orgId, occurredAt])
  @@index([orgId, createdAt])
  @@map("failed_events")
}

/// Daily rollup for fast dashboards (per org + event type).
model UsageMetricDaily {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  metricDate       DateTime @map("metric_date") @db.Date
  eventType        String   @map("event_type")
  successfulCount  Int      @default(0) @map("successful_count")
  failedCount      Int      @default(0) @map("failed_count")
  revenueGenerated Decimal  @default(0) @map("revenue_generated") @db.Decimal(18, 8)
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metricDate, eventType])
  @@index([orgId, metricDate])
  @@map("usage_metrics_daily")
}

/// Monthly statement (invoice-like) even when using internal credits only.
model BillingStatement {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  billingCycle String    @map("billing_cycle")
  status       String    @default("draft")
  finalizedAt  DateTime? @map("finalized_at")
  subtotal     Decimal   @db.Decimal(18, 8)
  total        Decimal   @db.Decimal(18, 8)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lineItems    BillingStatementLineItem[]

  @@unique([orgId, billingCycle])
  @@index([billingCycle])
  @@map("billing_statements")
}

model BillingStatementLineItem {
  id                 String   @id @default(uuid()) @db.Uuid
  billingStatementId String   @map("billing_statement_id") @db.Uuid
  eventType          String   @map("event_type")
  description        String?
  quantity           Int      @default(0)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(18, 8)
  amount             Decimal  @db.Decimal(18, 8)
  createdAt          DateTime @default(now()) @map("created_at")

  billingStatement BillingStatement @relation(fields: [billingStatementId], references: [id], onDelete: Cascade)

  @@index([billingStatementId])
  @@map("billing_statement_line_items")
}

/// Active subscription linking an org to a pricing plan and tracking renewal periods.
model OrgSubscription {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @unique @map("org_id") @db.Uuid
  /// Must match PricingTier.name.
  planName           String   @map("plan_name")
  /// "trialing" | "active" | "expired" | "canceled" | "past_due"
  status             String   @default("active")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  /// When true, cancel at end of current period rather than auto-renew.
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@map("org_subscriptions")
}

/// Maps a canonical model tier (economy/standard/advanced/premium) to a per-step INR price and
/// the OpenRouter model-id prefixes that resolve to it.
model ModelTier {
  id            String   @id @default(uuid()) @db.Uuid
  /// "economy" | "standard" | "advanced" | "premium"
  tierKey       String   @unique @map("tier_key")
  displayName   String   @map("display_name")
  /// Price per agent task-step in INR.
  pricePerStep  Decimal  @map("price_per_step") @db.Decimal(18, 8)
  /// OpenRouter model-id prefixes that resolve to this tier (e.g. "openrouter/anthropic/claude-haiku").
  modelPrefixes String[] @map("model_prefixes")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("model_tiers")
}

/// Append-only log for billing engine/admin actions.
model BillingLog {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  action       String
  details      Json?
  status       String
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("billing_logs")
}

// ─── Teams ────────────────────────────────────────────────────────────────────

/// A named group of agents that collaborate on tasks via the A2A protocol.
model Team {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id") @db.Uuid
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  /// The agent that acts as orchestrator/supervisor for this team. Null until assigned after creation.
  supervisorAgentId String?  @map("supervisor_agent_id")
  /// Team-level W3C DID (did:qlix:<team-id>), generated at creation.
  did               String   @unique
  name              String
  description       String?
  /// `draft` | `active` | `archived`
  status            String   @default("draft")
  /// Execution config: maxParallelWorkers, subtaskTimeoutMs, retryPolicy, humanInLoopTriggers.
  config            Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("TeamsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  supervisorAgent Agent?       @relation("TeamSupervisor", fields: [supervisorAgentId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  runs            TeamRun[]

  @@index([orgId])
  @@index([createdByUserId])
  @@map("teams")
}

/// Membership record linking an agent to a team with a role and narrowed scope set.
model TeamMember {
  id                String   @id @default(cuid())
  teamId            String   @map("team_id")
  agentId           String   @map("agent_id")
  /// Human-readable role label, e.g. "researcher", "writer", "validator".
  role              String
  /// Subset of the agent's full scopes active in this team context.
  delegatedScopes   String[] @default([]) @map("delegated_scopes")
  /// Agent Card JSON snapshot at time of joining (point-in-time record).
  agentCardSnapshot Json?    @map("agent_card_snapshot")
  /// Pipeline stage (1-indexed). In pipeline mode with autoSequence=false, workers run in ascending order of this field. Members added later default to (max+1) so new agents go to the end of the pipeline.
  stageOrder        Int      @default(0) @map("stage_order")
  addedAt           DateTime @default(now()) @map("added_at")

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([teamId, agentId])
  @@index([teamId])
  @@index([agentId])
  @@index([teamId, stageOrder])
  @@map("team_members")
}

/// A single execution of a team against a user-supplied goal.
model TeamRun {
  id                     String    @id @default(cuid())
  teamId                 String    @map("team_id")
  orgId                  String    @map("org_id") @db.Uuid
  startedByUserId        String    @map("started_by_user_id") @db.Uuid
  goal                   String    @db.Text
  /// `web` | `whatsapp` | `api` | `slack` | `telegram` — where the run was started.
  sourceChannel          String    @default("web") @map("source_channel")
  /// Connector UUID when started from WhatsApp.
  sourceConnectorId      String?   @map("source_connector_id") @db.Uuid
  /// `whatsapp` | `none` — where to send the final result.
  replyChannel           String    @default("none") @map("reply_channel")
  /// `queued` | `running` | `paused` | `completed` | `failed` | `canceled`
  status                 String    @default("queued")
  /// Supervisor reasoning/planning steps (JSON array, append-only).
  supervisorTrace        Json      @default("[]") @map("supervisor_trace")
  /// Artifacts produced during the run (JSON array of {type, name, content, agentId, createdAt}).
  artifacts              Json      @default("[]")
  /// JIT scope escalation requests made during this run.
  scopeEscalations       Json      @default("[]") @map("scope_escalations")
  /// Durable pipeline state saved while this run is waiting for an external trigger.
  checkpointJson         Json?     @map("checkpoint_json")
  /// Immutable source handles for Luna-Teams (authoritative user inputs vs reference assets).
  inputs                 Json      @default("[]")
  /// Final synthesized result from the supervisor.
  result                 Json?
  errorMessage           String?   @map("error_message")
  /// Prior TeamRun this follow-up continues (same team conversation).
  continuesRunId         String?   @map("continues_run_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  startedAt              DateTime? @map("started_at")
  completedAt            DateTime? @map("completed_at")

  team           Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  startedBy      User                   @relation("TeamRunsStarted", fields: [startedByUserId], references: [id], onDelete: Cascade)
  continuedFrom  TeamRun?               @relation("TeamRunFollowUp", fields: [continuesRunId], references: [id], onDelete: SetNull)
  followUps      TeamRun[]              @relation("TeamRunFollowUp")
  events         TeamRunEvent[]
  a2aTasks       A2ATask[]
  agentRuns      AgentRun[]
  mailbox        TeamMailboxMessage[]
  waitTriggers   WaitTrigger[]
  channelSession TeamRunChannelSession?

  @@index([teamId, createdAt])
  @@index([orgId, createdAt])
  @@index([status, createdAt])
  @@index([sourceConnectorId, status])
  @@index([continuesRunId])
  @@map("team_runs")
}

/// Durable Luna-Teams handoff. Messages are conversational context; Results are
/// terminal worker handbacks consumed by the commander host.
model TeamMailboxMessage {
  id               String   @id @default(cuid())
  teamRunId        String   @map("team_run_id")
  teamId           String   @map("team_id")
  kind             String   @default("result")
  status           String   @default("pending")
  senderAgentId    String?  @map("sender_agent_id")
  recipientAgentId String?  @map("recipient_agent_id")
  a2aTaskId        String?  @map("a2a_task_id")
  agentRunId       String?  @map("agent_run_id")
  contractId       String?  @map("contract_id")
  payload          Json
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  run TeamRun @relation(fields: [teamRunId], references: [id], onDelete: Cascade)

  @@index([teamRunId, kind, createdAt])
  @@index([teamRunId, status])
  @@index([a2aTaskId])
  @@index([agentRunId])
  @@map("team_mailbox_messages")
}

/// Durable external-event wait for an agent or a paused team pipeline.
/// V1 matches an inbound WhatsApp message by connector + contact JID.
model WaitTrigger {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// `whatsapp_inbound` now; schema leaves room for webhook, timeout and human approval.
  kind             String
  /// `open` | `fulfilled` | `expired` | `canceled`
  status           String    @default("open")
  /// `first_match` | `collect_until_timeout`
  fulfillment      String    @default("first_match")
  connectorId      String?   @map("connector_id") @db.Uuid
  contactJid       String?   @map("contact_jid")
  agentId          String?   @map("agent_id")
  /// `resume_team_run` | `spawn_agent_run`
  continuationKind String    @map("continuation_kind")
  teamRunId        String?   @map("team_run_id")
  replyInstructions String?  @map("reply_instructions") @db.Text
  /// Matched events ({jid, text, timestampMs, pushName}[]).
  inboundJson      Json      @default("[]") @map("inbound_json")
  armedAt          DateTime  @default(now()) @map("armed_at")
  expiresAt        DateTime  @map("expires_at")
  fulfilledAt      DateTime? @map("fulfilled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  teamRun TeamRun? @relation(fields: [teamRunId], references: [id], onDelete: Cascade)

  @@index([connectorId, contactJid, status, expiresAt])
  @@index([teamRunId, status])
  @@index([status, kind, expiresAt])
  @@map("wait_triggers")
}

/// Binds an active WhatsApp connector to a team run for inject/status/cancel.
model TeamRunChannelSession {
  id          String   @id @default(cuid())
  connectorId String   @unique @map("connector_id") @db.Uuid
  teamRunId   String   @unique @map("team_run_id")
  teamId      String   @map("team_id")
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  run TeamRun @relation(fields: [teamRunId], references: [id], onDelete: Cascade)

  @@index([teamRunId])
  @@map("team_run_channel_sessions")
}

/// Durable mid-run user guidance for cloud runners (replaces in-process Map).
model RunInjection {
  id         String    @id @default(cuid())
  agentRunId String    @map("agent_run_id")
  message    String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([agentRunId, consumedAt])
  @@map("run_injections")
}

/// Append-only event log for a TeamRun — the canonical execution record (event sourcing).
model TeamRunEvent {
  id          String  @id @default(cuid())
  runId       String  @map("run_id")
  teamId      String  @map("team_id")
  agentId     String? @map("agent_id")
  seq         Int
  /// task_delegated | tool_called | result_received | scope_requested | approval_granted | artifact_produced | subtask_completed | run_started | run_completed | run_failed | supervisor_step
  eventType   String  @map("event_type")
  payload     Json
  /// SHA-256 of previous event's payload (or "genesis" for seq=0).
  prevHash    String  @map("prev_hash")
  timestampMs BigInt  @map("timestamp_ms")

  run TeamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, timestampMs])
  @@index([teamId, timestampMs])
  @@map("team_run_events")
}

/// An A2A-protocol task delegated from supervisor to a worker agent.
model A2ATask {
  id            String    @id @default(cuid())
  runId         String    @map("run_id")
  teamId        String    @map("team_id")
  fromAgentId   String    @map("from_agent_id")
  toAgentId     String    @map("to_agent_id")
  goal          String    @db.Text
  /// A2A lifecycle: submitted | working | input_required | completed | failed | canceled | rejected
  status        String    @default("submitted")
  /// Message thread ({role, content, timestampMs}[]).
  messages      Json      @default("[]")
  /// Typed output artifacts produced by the worker.
  artifacts     Json      @default("[]")
  /// Present when status=input_required: what the worker needs.
  inputRequest  Json?     @map("input_request")
  /// Human or supervisor response to the input_required request.
  inputResponse Json?     @map("input_response")
  errorMessage  String?   @map("error_message")
  /// Linked cloud-runner work item for this delegation.
  agentRunId    String?   @unique @map("agent_run_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")

  run      TeamRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([toAgentId, status])
  @@map("a2a_tasks")
}

// ─── End Teams ────────────────────────────────────────────────────────────────

/// Saved NL agent builder prompts per user for history/reuse (newest first, max 20).
model NlBuilderHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  prompt    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("nl_builder_history")
}

/// Full AI Builder chat session (transcript + created agent refs), scoped to user + workspace org.
model NlBuilderSession {
  id              String   @id @default(cuid())
  userId          String   @map("user_id") @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  title           String   @default("New chat") @db.VarChar(160)
  /// Durable chat items (user/info/error/plan/done) — no private keys or starter packs.
  transcript      Json     @default("[]")
  createdAgentIds String[] @default([]) @map("created_agent_ids")
  teamId          String?  @map("team_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, orgId, updatedAt])
  @@map("nl_builder_sessions")
}

// ─── Job apply copilot ────────────────────────────────────────────────────────

/// Per-org candidate profile used by the Job Apply Copilot (resume + structured answers).
model JobCandidateProfile {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  fullName        String?  @map("full_name")
  email           String?
  phone           String?
  location        String?
  linkedinUrl     String?  @map("linkedin_url")
  githubUrl       String?  @map("github_url")
  portfolioUrl    String?  @map("portfolio_url")
  /// Work auth / visa / relocation notes
  workAuth        String?  @map("work_auth")
  salaryBand      String?  @map("salary_band")
  summary         String?
  /// Structured experience / education / skills
  experience      Json     @default("[]")
  education       Json     @default("[]")
  skills          String[] @default([])
  /// Screening Q&A bank: [{ question, answer }]
  answerBank      Json     @default("[]") @map("answer_bank")
  /// Sandbox file id for the resume binary
  resumeSandboxId String?  @map("resume_sandbox_id")
  resumeFileName  String?  @map("resume_file_name")
  resumeMimeType  String?  @map("resume_mime_type")
  resumeUrl       String?  @map("resume_url")
  /// Extracted plain text for agent brief
  resumeText      String?  @map("resume_text") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation("JobCandidateProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  campaigns    JobApplyCampaign[]

  @@unique([orgId, userId])
  @@index([orgId])
  @@map("job_candidate_profiles")
}

/// A batch of applications (search query or pasted URLs).
model JobApplyCampaign {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  profileId   String?  @map("profile_id")
  name        String
  /// draft | queued | applying | completed | failed
  status      String   @default("draft")
  searchQuery String?  @map("search_query")
  /// Company board tokens / slugs searched: [{ ats, board }]
  boards      Json     @default("[]")
  agentId     String?  @map("agent_id")
  stats       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("JobApplyCampaignCreator", fields: [createdById], references: [id], onDelete: Cascade)
  profile      JobCandidateProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([orgId, createdAt(sort: Desc)])
  @@index([status])
  @@map("job_apply_campaigns")
}

model JobApplication {
  id              String    @id @default(cuid())
  campaignId      String    @map("campaign_id")
  orgId           String    @map("org_id") @db.Uuid
  company         String
  title           String
  location        String?
  applyUrl        String    @map("apply_url")
  /// greenhouse | lever | ashby | unknown
  ats             String    @default("unknown")
  externalJobId   String?   @map("external_job_id")
  /// queued | filling | awaiting_jit | submitted | blocked | failed | skipped
  status          String    @default("queued")
  resultNote      String?   @map("result_note")
  confirmationUrl String?   @map("confirmation_url")
  agentRunId      String?   @map("agent_run_id")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  campaign JobApplyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, applyUrl])
  @@index([campaignId, status])
  @@index([orgId])
  @@map("job_applications")
}

// ─── End job apply copilot ────────────────────────────────────────────────────

/// Periodic Merkle roots over the action log hash chain for tamper evidence.
model MerkleCheckpoint {
  id              String   @id @default(uuid()) @db.Uuid
  fromTimestampMs BigInt   @map("from_timestamp_ms")
  toTimestampMs   BigInt   @map("to_timestamp_ms")
  merkleRoot      String   @map("merkle_root")
  entryCount      Int      @map("entry_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("merkle_checkpoints")
}

/// Public beta waitlist signup. Exactly one contact method is stored.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

/// Privacy-preserving count of browsers that have visited the public homepage.
model HomepageVisit {
  id               String   @id @default(uuid()) @db.Uuid
  visitorTokenHash String   @unique @map("visitor_token_hash") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("homepage_visits")
}

/// Generic short-lived key/value store, replacing several in-process Maps (WebAuthn
/// challenges, JIT run-scoped grants, lead-outreach gate signals) so they survive a
/// backend restart and stay correct the moment more than one instance runs (see
/// `backend/src/lib/ephemeralGrants.ts`).
model EphemeralGrant {
  id        String   @id @default(cuid())
  namespace String
  key       String
  value     Json?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([namespace, key])
  @@index([expiresAt])
  @@map("ephemeral_grants")
}

/// User-issued API key for programmatic access. Only a sha256 `keyHash` is stored —
/// the raw key is shown once at creation time and is never persisted or logged.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id") @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  label      String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  /// Developer API scopes (e.g. agents:read). Empty treated as full grant at read time for legacy rows.
  scopes     String[]  @default([]) @map("scopes")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@map("api_keys")
}

/// Cron / schedule for AI Employees (Hermes-style cronjob).
model EmployeeSchedule {
  id                   String    @id @default(cuid())
  orgId                String    @map("org_id") @db.Uuid
  agentId              String    @map("agent_id")
  engagementId         String?   @map("engagement_id")
  /// 5-field cron expression (UTC), e.g. `0 9 * * 1-5`
  cronExpression       String    @map("cron_expression")
  /// Natural-language description of the schedule (optional).
  label                String?
  /// Prompt / goal enqueued on each tick.
  prompt               String
  enabled              Boolean   @default(true)
  lastEnqueuedAt       DateTime? @map("last_enqueued_at")
  nextRunAt            DateTime? @map("next_run_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  engagement EmployeeEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([orgId, enabled])
  @@index([nextRunAt])
  @@index([agentId])
  @@map("employee_schedules")
}

/// Generic scheduled event — cron / once / interval — fires an agent run (or future action types).
/// Independent of EmployeeSchedule; agents and AI Brain create these via qlix-schedule MCP / brain tools.
model ScheduledEvent {
  id                 String    @id @default(cuid())
  orgId              String    @map("org_id") @db.Uuid
  /// Agent that receives the run when the event fires.
  agentId            String    @map("agent_id")
  /// Agent that created the schedule (MCP caller); null for console / brain.
  createdByAgentId   String?   @map("created_by_agent_id")
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  /// `cron` | `once` | `interval`
  scheduleType       String    @map("schedule_type")
  /// 5-field UTC cron when scheduleType=cron, e.g. `0 9 * * 1-5`
  cronExpression     String?   @map("cron_expression")
  /// Absolute fire time when scheduleType=once
  onceAt             DateTime? @map("once_at")
  /// Seconds between fires when scheduleType=interval (min 60)
  intervalSeconds    Int?      @map("interval_seconds")
  timezone           String    @default("UTC")
  /// `agent_run` for now (webhook reserved)
  actionType         String    @default("agent_run") @map("action_type")
  label              String?
  /// Prompt / goal enqueued on each fire for actionType=agent_run
  prompt             String
  payloadJson        Json?     @map("payload_json")
  enabled            Boolean   @default(true)
  /// `active` | `paused` | `cancelled` | `completed`
  status             String    @default("active")
  lastEnqueuedAt     DateTime? @map("last_enqueued_at")
  nextRunAt          DateTime? @map("next_run_at")
  runCount           Int       @default(0) @map("run_count")
  maxRuns            Int?      @map("max_runs")
  lastError          String?   @map("last_error")
  /// `mcp` | `console` | `brain`
  source             String    @default("mcp")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent          Agent        @relation("ScheduledEventTarget", fields: [agentId], references: [id], onDelete: Cascade)
  createdByAgent Agent?       @relation("ScheduledEventCreator", fields: [createdByAgentId], references: [id], onDelete: SetNull)

  @@index([orgId, status, enabled])
  @@index([enabled, nextRunAt])
  @@index([agentId])
  @@index([createdByAgentId])
  @@map("scheduled_events")
}

/// Org skill library — promote a successful run into a reusable skill.
model OrgSkill {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id") @db.Uuid
  name            String
  description     String    @default("")
  /// Skill body / instructions (markdown or plain).
  content         String
  /// Optional source run that was promoted.
  sourceRunId     String?   @map("source_run_id")
  sourceAgentId   String?   @map("source_agent_id")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  /// `draft` | `approved` | `archived`
  status          String    @default("draft")
  approvedAt      DateTime? @map("approved_at")
  approvedByUserId String?  @map("approved_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceAgent Agent?       @relation(fields: [sourceAgentId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId, status])
  @@map("org_skills")
}

/// A saved Visual Builder canvas. Draft-only: nothing here mutates agents or teams.
model BuilderCanvas {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  name            String
  /// { version, nodes, edges, groups, viewport }. Nodes store references (agentId /
  /// scopeId), never snapshots — labels are re-hydrated from live data on load.
  graph           Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("BuilderCanvasCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([orgId, updatedAt])
  @@index([createdByUserId])
  @@map("builder_canvases")
}
