{
  "name": "qlix-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/main.ts",
    "build": "tsc && mkdir -p dist/openapi && cp -f openapi/qlix-developer-v1.json dist/openapi/qlix-developer-v1.json",
    "start": "node dist/main.js",
    "test": "node --import tsx --test $(rg --files -g '*.test.ts' src)",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@prisma/client": "^6.19.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^7.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "undici": "^6.27.0",
    "ws": "^8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
