# Copy to `frontend/.env.local` (or `.env`). Next.js exposes only variables prefixed with NEXT_PUBLIC_ to the browser.
#
# Must match the Qlix API base URL and the backend’s CORS / FRONTEND_URL (same host you type in the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional: billing display conversion (if used by billing UI)
# NEXT_PUBLIC_BILLING_USD_INR_RATE=83
