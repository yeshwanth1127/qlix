{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qlix.dev/contracts/gtm/v1/account-research-result.schema.json",
  "title": "GTM Account Research Result v1",
  "description": "Extraction result only. The backend validity engine, not the research agent, determines verification and qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "claims", "hypotheses", "warnings", "missingInformation"],
  "properties": {
    "schemaVersion": { "const": "gtm.account_research.result.v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "canonicalName", "canonicalDomain", "candidateEntities", "sourceSnapshotIds"],
      "properties": {
        "status": { "enum": ["resolved", "ambiguous", "unresolved"] },
        "canonicalName": { "type": ["string", "null"], "maxLength": 240 },
        "canonicalDomain": { "type": ["string", "null"], "maxLength": 253 },
        "candidateEntities": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "domain", "reason", "sourceSnapshotIds"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 240 },
              "domain": { "type": ["string", "null"], "maxLength": 253 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "sourceSnapshotIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
            }
          }
        },
        "sourceSnapshotIds": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "predicate", "value", "timeScope", "support", "extractionConfidence"],
        "properties": {
          "claimId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "predicate": { "enum": ["legal_name", "trading_name", "headquarters", "operating_location", "facility_count", "employee_band", "industry", "certification", "technology", "hiring_signal", "expansion_signal", "operational_workflow", "other"] },
          "value": { "type": ["string", "number", "boolean"] },
          "unit": { "type": ["string", "null"], "maxLength": 80, "default": null },
          "timeScope": { "type": ["string", "null"], "maxLength": 160 },
          "support": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "contains": {
              "type": "object",
              "required": ["relationship"],
              "properties": { "relationship": { "const": "supports" } }
            },
            "minContains": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceSnapshotId", "excerpt", "relationship"],
              "properties": {
                "sourceSnapshotId": { "type": "string", "minLength": 1, "maxLength": 160 },
                "excerpt": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "selector": { "type": ["string", "null"], "maxLength": 1000, "default": null },
                "relationship": { "enum": ["supports", "contradicts"] }
              }
            }
          },
          "extractionConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesisId", "statement", "basisClaimIds", "validationQuestions"],
        "properties": {
          "hypothesisId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "basisClaimIds": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "validationQuestions": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "missingInformation": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
  }
}
