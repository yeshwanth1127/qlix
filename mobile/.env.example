# Copy this file to `.env` and adjust the value for your environment.
#
# QLIX_API_BASE_URL — the base URL of the Qlix backend (no trailing slash).
#   Android emulator  -> http://10.0.2.2:4000   (10.0.2.2 maps to host localhost)
#   iOS simulator     -> http://localhost:4000
#   Windows / web      -> http://localhost:4000
#   Physical device   -> http://<your-machine-LAN-IP>:4000
QLIX_API_BASE_URL=http://10.0.2.2:4000
