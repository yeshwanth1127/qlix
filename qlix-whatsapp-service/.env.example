PORT=3939
QLIX_URL=http://localhost:4000
SERVICE_SECRET=your-shared-secret-here
NODE_ENV=development
# Encrypts Baileys auth_info/<connectorId> session files at rest (AES-256-GCM).
# 64 hex chars (32 bytes) or base64 for 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=change-me-to-a-32-byte-random-key
# Max in-flight inbound turns per linked WhatsApp account (other contacts wait, they are not dropped).
# 64 covers a 500-lead reply storm without stampeding the backend; raise to 128 for heavier blasts.
# QLIX_INBOUND_MAX_CONCURRENT=64
# Max outstanding messages queued for one contact before a flood drop is logged.
# QLIX_INBOUND_MAX_QUEUED_PER_CONTACT=20
